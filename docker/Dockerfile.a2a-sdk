FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir "a2a-sdk==1.0.3" "uvicorn>=0.30,<1" "httpx>=0.27,<1" "sse-starlette>=2,<4" "cryptography>=44,<47"
RUN python -c "from a2a.server.routes import create_agent_card_routes, create_jsonrpc_routes"
COPY scripts/ ./scripts/
COPY collaboration/ ./collaboration/
ENV PYTHONUNBUFFERED=1
CMD ["python", "-m", "scripts.official_a2a_server"]
